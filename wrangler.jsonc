{
  "name": "challenge-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "emerge-mcp.raava.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  // Deployed version id and time, reported in /health and module_metrics provenance.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Same bindings as patient-360 (coach-console); same-account Worker-to-Worker fetches can hit error 1042.
  // "remote": true makes `wrangler dev` call the deployed module Workers; deploy ignores it.
  // Limits on the tools that call a live model (score_conversation, coaching_cue, glucose_advice).
  // LLM_LIMIT: anonymous callers, per client IP. KEY_LIMIT: callers with a bearer key (secret MCP_KEYS), per key.
  // Must match LLM_PER_MINUTE and KEY_PER_MINUTE in src/index.ts.
  "ratelimits": [
    { "name": "LLM_LIMIT", "namespace_id": "6006", "simple": { "limit": 20, "period": 60 } },
    { "name": "KEY_LIMIT", "namespace_id": "6007", "simple": { "limit": 60, "period": 60 } }
  ],
  "services": [
    { "binding": "C1", "service": "c1-acute-risk", "remote": true },
    { "binding": "C3", "service": "c3-rough-patch", "remote": true },
    { "binding": "C4", "service": "c4-glucose-guide", "remote": true },
    { "binding": "C5", "service": "coach-copilot-clef", "remote": true },
    { "binding": "P360", "service": "patient-360", "remote": true }
  ]
}
